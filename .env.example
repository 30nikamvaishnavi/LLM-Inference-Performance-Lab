LLM_LAB_ENVIRONMENT=development
LLM_LAB_DEBUG=false
LLM_LAB_LOG_LEVEL=INFO
LLM_LAB_MODEL_CACHE_DIR=~/.cache/llm-inference-performance-lab/models
